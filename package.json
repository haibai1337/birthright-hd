{
  "name": "birthright-hd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/game",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/game/vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config apps/game/vite.config.ts",
    "preview": "vite preview --config apps/game/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:check": "node scripts/check-desktop.mjs",
    "release:check": "node scripts/check-release.mjs",
    "inventory": "node packages/import-tools/inventory.mjs",
    "simulate": "vitest run tests/simulation.test.ts",
    "format": "prettier --write apps/game/src packages tests scripts *.json *.ts *.mjs docs README.md",
    "format:check": "prettier --check apps/game/src packages tests scripts *.json *.ts *.mjs docs README.md"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "6.15.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
